{
  "name": "dsh-local-radiance-server-controller",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "keywords": ["dsh", "deepseek-harness", "cordis", "plugin", "ssh", "radiance", "amd", "docker-compose", "inference"],
  "type": "module",
  "description": "Control a local-LAN AMD inference server over SSH: GPU power limit, Radiance docker-compose service, image pull, amd-smi info, shutdown and reboot.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "assets/*", "icon.svg"],
  "dependencies": {
    "node-ssh": "^13.2.0"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
